# Copy this file to .env and fill in your own values

# Secret key for Flask sessions (use a long random string in production)
SECRET_KEY=change-this-to-a-long-random-string

# Anthropic API key - powers the AI Tutor, question generation, and AI marking
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for AI features (leave as-is unless you know you want a different one)
ANTHROPIC_MODEL=claude-sonnet-5

# Database (SQLite file by default - no setup needed)
DATABASE_URL=sqlite:///tutorai.db

# Pricing (KES) - edit to change prices system-wide
PRICE_STANDARD=1200
PRICE_NATIONAL=3000
PRICE_INTERNATIONAL=6000
TEACHER_LICENSE_FEE=1500
TEACHER_LICENSE_YEARS=3

# Default admin account created on first run (change the password after first login!)
ADMIN_EMAIL=admin@tutorai.local
ADMIN_PASSWORD=Admin@12345
